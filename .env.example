# Walrus Memory — generate both at https://staging.memory.walrus.xyz
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=
MEMWAL_SERVER_URL=https://relayer-staging.memory.walrus.xyz

# Embedding distance above which a recalled memory is treated as noise and kept
# out of the prompt. Default 0.6. Raise it if the tutor is missing facts it
# should know; lower it if unrelated entries are reaching the model. Distances
# are not portable across relayer versions, so this is a dial, not a constant.
EA_RELEVANCE_DISTANCE=

# Sui contract ids for delegate-key registration (from the Walrus Memory dashboard)
MEMWAL_PACKAGE_ID=
MEMWAL_REGISTRY_ID=

# Enoki zkLogin — https://portal.enoki.mystenlabs.com
NEXT_PUBLIC_ENOKI_API_KEY=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ==============================================================================
# FREE AI MODELS & LLM PROVIDERS (Zero-Cost Operation)
# ==============================================================================
# Any key set here serves as a server-level fallback for all visitors.
# Visitors can also provide their personal keys at /settings, sealed with AES-256-GCM.
#
# 1. Google Gemini 2.0 Flash / 1.5 Flash (RECOMMENDED - 100% Free Tier)
#    Get key: https://aistudio.google.com/apikey
#    Limits: 15 Requests/Min, 1 Million Tokens/Min, 1,500 Requests/Day free.
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_API_KEY=

# 2. Groq Cloud (Ultra-Fast Llama 3.3 70B & Llama 3.1 8B - Free Tier)
#    Get key: https://console.groq.com/keys
#    Limits: 30 Requests/Min, ~300 tokens/second inference.
GROQ_API_KEY=

# 3. OpenRouter (DeepSeek R1 :free, Qwen 2.5 Coder :free, Llama 3.3 :free)
#    Get key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Paid Model Providers (Optional)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
EA_MODEL_PROVIDER=

# Model overrides. By default ONE model does both jobs: it teaches the student
# and it reads each turn for facts worth remembering. Splitting them means a
# gate running on a model nobody chose, which fails silently on every turn.
# Set EA_EXTRACT_MODEL only if you want a cheaper tier on the gate.
EA_CHAT_MODEL=
EA_EXTRACT_MODEL=

# Ollama (optional self-hosted LLM).
# In local dev, localhost:11434 is tried automatically if OLLAMA_BASE_URL is unset.
# In production (Vercel), set OLLAMA_BASE_URL to a publicly reachable Ollama server.
# Leave blank to skip Ollama entirely in production.
OLLAMA_BASE_URL=
# Which Ollama model to call. Defaults to "llama3" if unset.
OLLAMA_MODEL=llama3

# ==============================================================================
# SECURITY — REQUIRED IN PRODUCTION
# ==============================================================================
# Session cookie signing key & zkLogin master salt key
# Generate with: openssl rand -hex 32
# CRITICAL: Missing SESSION_SECRET causes a hard error when encrypting blobs in production.
SESSION_SECRET=
ZKLOGIN_SALT_MASTER_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side admin key — never expose this to the client
SUPABASE_SERVICE_ROLE_KEY=

# Admin/cron endpoint protection key
# Secures /api/admin/* and /api/cron/* routes — generate with: openssl rand -hex 32
ADMIN_SERVICE_KEY=
CRON_SECRET=

# ==============================================================================
# JOB AGGREGATION
# ==============================================================================
# SerpAPI key for Google Jobs aggregation (optional, falls back gracefully)
SERPAPI_API_KEY=

# RapidAPI / Indeed integration (optional)
RAPIDAPI_KEY=

# ==============================================================================
# INTEGRATIONS
# ==============================================================================
# Notion sync (optional)
NOTION_API_KEY=
NOTION_DATABASE_ID=

# MCP server: whose memory it speaks for (a Sui address)
EA_OWNER_ADDRESS=

# Skip zkLogin locally and act as this address. Refused in production.
DEV_FAKE_ADDRESS=

# The origin the browser actually loads the app from. Enoki sends
# "<this>/signin" to Google as the OAuth redirect_uri, and Google matches it
# verbatim against the registered list. Leave blank locally to use the current
# origin; set it in deployments where the public URL differs.
NEXT_PUBLIC_APP_URL=

# Sui network for zkLogin. Must be the same value the Enoki wallet is
# registered with and the one the server verifies proofs against — a testnet
# proof checked against mainnet is rejected as an invalid signature.
NEXT_PUBLIC_SUI_NETWORK=testnet

# Resend Transactional Email API - https://resend.com
# Primary Account (3,000 free emails/mo)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Career Ace <notifications@careerace.online>
# Optional Secondary Account for 6,000/mo quota and automatic failover
RESEND_API_KEY_2=
RESEND_FROM_EMAIL_2=Career Ace <notifications@careerace.online>
# Optional Tertiary Account for 9,000/mo quota and automatic failover
RESEND_API_KEY_3=
RESEND_FROM_EMAIL_3=Career Ace <notifications@careerace.online>

# Walrus Console Sovereign Storage Vault (https://console.walrus.xyz)
# Encrypted transcripts, audit vaults, and sovereign file storage
WALRUS_CONSOLE_API_KEY=
WALRUS_CONSOLE_SERVICE_KEY=
WALRUS_CONSOLE_ACCOUNT_ADDRESS=
WALRUS_CONSOLE_ADMIN_KEY=
WALRUS_CONSOLE_ADMIN_SERVICE_KEY=

# Walrus network endpoints (defaults to testnet if unset)
WALRUS_PUBLISHER_URL=https://publisher.walrus-testnet.walrus.space
WALRUS_AGGREGATOR_URL=https://aggregator.walrus-testnet.walrus.space

# Pinata IPFS Decentralized Sovereign Storage (https://pinata.cloud)
# Industry-standard decentralized pinning for IPFS content-addressed storage
PINATA_API_KEY=
PINATA_API_SECRET=
PINATA_JWT=
PINATA_GATEWAY_URL=https://gateway.pinata.cloud/ipfs
